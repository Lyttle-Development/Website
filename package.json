{
  "name": "website",
  "version": "1.0.0",
  "description": "LyttleDevelopment Website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bash scripts/update-lib.sh && cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm build && npm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm package-lock.json && npm --ignore-workspace install",
    "start": "npm run build && next start -p 3000",
    "docker:setup": "npm run build",
    "docker:build": "docker build -t lyttledev-website .",
    "postinstall": "bash scripts/update-lib.sh"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.2.5",
    "@fontsource/poppins": "^5.2.6",
    "@payloadcms/admin-bar": "^3.38.0",
    "@payloadcms/db-postgres": "^3.38.0",
    "@payloadcms/email-resend": "^3.38.0",
    "@payloadcms/live-preview-react": "^3.38.0",
    "@payloadcms/next": "latest",
    "@payloadcms/payload-cloud": "^3.38.0",
    "@payloadcms/plugin-form-builder": "^3.38.0",
    "@payloadcms/plugin-nested-docs": "^3.38.0",
    "@payloadcms/plugin-redirects": "^3.38.0",
    "@payloadcms/plugin-search": "^3.38.0",
    "@payloadcms/plugin-seo": "^3.38.0",
    "@payloadcms/richtext-lexical": "^3.38.0",
    "@payloadcms/storage-uploadthing": "^3.38.0",
    "@payloadcms/ui": "latest",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.0.2",
    "@types/styled-components": "^5.1.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.4.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.378.0",
    "next": "^15.3.2",
    "next-sitemap": "^4.2.3",
    "payload": "^3.38.0",
    "prism-react-renderer": "^2.4.1",
    "random-seed": "^0.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "sass": "^1.89.0",
    "sharp": "^0.32.6",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^22.15.18",
    "@types/random-seed": "^0.3.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "copyfiles": "^2.4.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.3.0",
  "engines": {
    "node": "22.11.0"
  },
  "volta": {
    "node": "22.11.0"
  },
  "npm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
